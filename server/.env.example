# =================================
# Application
# =================================

NODE_ENV=development
PORT=4000

# =================================
# Database
# =================================

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/convoquer26_dev

# =================================
# Google OAuth
# =================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =================================
# Session Security
# =================================

SESSION_SECRET=

# =================================
# Production Bootstrap
# =================================
# The first @iitjammu.ac.in account to sign in with this exact email is
# automatically granted CONVENER. Only takes effect while zero CONVENERs
# exist anywhere in the system — safe to leave set permanently, it will
# never re-trigger or escalate anyone after the first use.
CONVENER_BOOTSTRAP_EMAIL=

# Hard-locks two sensitive areas to this one exact account, on top of the
# ordinary permission checks that already guard them: RBAC administration
# (view/assign/revoke roles) and tournament-structure endpoints (create/
# update/delete a tournament, seeding, stages, generating its bracket/
# round-robin/Swiss round). Even if a role like WEB_DEV_HEAD is ever granted
# to someone else, only this email can actually use either. Sports
# Coordinators still create/edit matches inside an existing tournament
# structure — this only locks down who can build the structure itself.
# Leave unset to fall back to permissions alone.
SOLE_ADMIN_EMAIL=

# =================================
# Field-level encryption (PII at rest)
# =================================
# 32-byte key, hex (64 chars) or base64. Encrypts User.email and
# Participant.contactNumber/rollNumber at rest. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=

# =================================
# WhatsApp Business Cloud API (Meta)
# =================================
# Used to notify volunteers of new task/venue assignments. If left unset,
# sends are skipped (logged, never blocking the assignment).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
