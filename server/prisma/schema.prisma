generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===================================
// IDENTITY & RBAC
// ===================================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  profilePhotoUrl String?
  googleSubjectId String    @unique
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  sessions       Session[]
  userRoles      UserRole[]
  auditLogs      AuditLog[]      @relation("AuditLogUser")
  matchOfficials MatchOfficial[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id           String    @id @default(uuid())
  userId       String
  roleId       String
  eventId      String?
  departmentId String?
  sportId      String?
  assignedBy   String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // A user can only have a specific role once per combination of context (event, department, sport)
  @@unique([userId, roleId, eventId, departmentId, sportId])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  tokenHash        String    @unique
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason String?
  ipAddress        String?
  userAgent        String?
  deviceMetadata   Json?
  lastRotationAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===================================
// SYSTEM
// ===================================

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  action        String
  resource      String
  resourceId    String?
  previousState Json?
  newState      Json?
  time          DateTime @default(now())
  sessionId     String?
  ipAddress     String?
  reason        String?

  user User? @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)
}

// ===================================
// EVENT & COMPETITION (INITIAL)
// ===================================

model Event {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  edition     String
  startDate   DateTime
  endDate     DateTime
  description String?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sports       Sport[]
  venues       Venue[]
  institutes   Institute[]
  teams        Team[]
  participants Participant[]
  tournaments  Tournament[]
}

model Sport {
  id          String   @id @default(uuid())
  eventId     String
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teams       Team[]
  tournaments Tournament[]
}

model Venue {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  location  String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  matches Match[]
}

model Institute {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  shortName String?
  logoUrl   String?
  city      String?
  state     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teams        Team[]
  participants Participant[]
}

model Team {
  id          String   @id @default(uuid())
  eventId     String
  instituteId String
  sportId     String
  name        String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event           Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  institute       Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  sport           Sport                @relation(fields: [sportId], references: [id], onDelete: Cascade)
  members         TeamMember[]
  matchesAsTeamA  Match[]              @relation("MatchTeamA")
  matchesAsTeamB  Match[]              @relation("MatchTeamB")
  matchesWon      Match[]              @relation("MatchWinner")
  tournamentSeeds TournamentTeamSeed[]
}

model Participant {
  id             String    @id @default(uuid())
  eventId        String
  instituteId    String?
  name           String
  photographUrl  String?
  rollNumber     String?
  gender         String?
  dateOfBirth    DateTime?
  contactNumber  String?
  category       String    @default("ATHLETE") // ATHLETE, AUDIENCE, GUEST, OFFICIAL
  isCheckedIn    Boolean   @default(false)
  checkedInAt    DateTime?
  gatePassNumber String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  institute   Institute?   @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  teamMembers TeamMember[]
}

model TeamMember {
  id            String      @id @default(uuid())
  teamId        String
  participantId String
  role          String      @default("PLAYER") // PLAYER, CAPTAIN, SUBSTITUTE
  jerseyNumber  Int?
  createdAt     DateTime    @default(now())

  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([teamId, participantId])
}

// ===================================
// TOURNAMENTS, STAGES & MATCH FIXTURES
// ===================================

model Tournament {
  id            String   @id @default(uuid())
  eventId       String
  sportId       String
  name          String
  format        String   @default("KNOCKOUT") // KNOCKOUT, ROUND_ROBIN, GROUP_KNOCKOUT, LEAGUE
  status        String   @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED
  pointsForWin  Int      @default(3)
  pointsForDraw Int      @default(1)
  pointsForLoss Int      @default(0)
  rulesJson     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event   Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sport   Sport                @relation(fields: [sportId], references: [id], onDelete: Cascade)
  stages  TournamentStage[]
  matches Match[]
  seeds   TournamentTeamSeed[]
}

model TournamentTeamSeed {
  id           String   @id @default(uuid())
  tournamentId String
  teamId       String
  seedNumber   Int      // 1, 2, 3, etc. Top 2 seeds placed on opposite halves so they cannot meet before Finals
  notes        String?  // e.g. "Defending Champion", "Pool A Seed 1"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
  @@unique([tournamentId, seedNumber])
}

model TournamentStage {
  id           String   @id @default(uuid())
  tournamentId String
  name         String   // e.g. "Quarterfinals", "Semifinals", "Final", "Group A"
  sequence     Int      @default(1)
  stageType    String   @default("KNOCKOUT") // KNOCKOUT, ROUND_ROBIN
  status       String   @default("PENDING") // PENDING, ONGOING, COMPLETED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    Match[]
}

model Match {
  id                 String    @id @default(uuid())
  tournamentId       String
  stageId            String?
  venueId            String?
  matchNumber        String?   // e.g. "FB-M01", "CRIC-SF1"
  teamAId            String?
  teamBId            String?
  teamAScore         Int?
  teamBScore         Int?
  winnerTeamId       String?
  status             String    @default("SCHEDULED") // SCHEDULED, LIVE, COMPLETED, ABANDONED, CANCELLED, RESCHEDULED
  scheduledStartTime DateTime
  scheduledEndTime   DateTime?
  actualStartTime    DateTime?
  actualEndTime      DateTime?
  scoreDetails       Json?     // Extra score breakdown: halves, quarters, sets, overs, bonus
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stage      TournamentStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  venue      Venue?           @relation(fields: [venueId], references: [id], onDelete: SetNull)
  teamA      Team?            @relation("MatchTeamA", fields: [teamAId], references: [id], onDelete: SetNull)
  teamB      Team?            @relation("MatchTeamB", fields: [teamBId], references: [id], onDelete: SetNull)
  winnerTeam Team?            @relation("MatchWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  officials  MatchOfficial[]
}

model MatchOfficial {
  id        String   @id @default(uuid())
  matchId   String
  userId    String
  role      String   @default("SCOREKEEPER") // SCOREKEEPER, REFEREE, UMPIRE, JUDGE
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

