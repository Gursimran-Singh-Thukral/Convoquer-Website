root = true

[*]

charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js, jsx, ts, tsx}]

indent_style = space
indent_size = 4

[*.{json, jsonc}]

indent_style = space
indent_size = 4

[*.{md, mdx}]

indent_style = space
indent_size = 4

[*.{yml, yaml}]

indent_style = space
indent_size = 2

[*.{css, scss}]

indent_style = space
indent_size = 4

[*.{html}]

indent_style = space
indent_size = 4
