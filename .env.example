# =================================
# Application & URLs
# =================================

NODE_ENV=development
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public Client API base URL (used by Next.js client)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# =================================
# Database
# =================================

DATABASE_URL=postgresql://username:password@localhost:5432/convoquer26_dev

# =================================
# Authentication
# =================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/callback

SESSION_SECRET=

# One-time production bootstrap: the first @iitjammu.ac.in account to sign in
# with this exact email is automatically granted CONVENER. Only takes effect
# while zero CONVENERs exist anywhere in the system — safe to leave set
# permanently, it will never re-trigger or escalate anyone after the first use.
CONVENER_BOOTSTRAP_EMAIL=

# =================================
# Field-level encryption (PII at rest)
# =================================
# 32-byte key, hex (64 chars) or base64 (44 chars). Encrypts User.email and
# Participant.contactNumber/rollNumber at rest. REQUIRED in production — the
# server refuses to boot without it once NODE_ENV=production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key permanently loses access to the encrypted data — back it
# up somewhere separate from the database itself.
FIELD_ENCRYPTION_KEY=
